# Copy this file to `.env` and fill in real values for LOCAL development.
# `.env` is gitignored and must NEVER be committed. In production (Render) set these as
# platform secrets instead of using a .env file.

# --- are.na ---
# Personal Access Token with WRITE scope, created at https://www.are.na/settings/oauth
ARENA_ACCESS_TOKEN=your-arena-personal-access-token
# The channel to drop blocks into (the slug from the channel URL).
ARENA_CHANNEL_SLUG=staging-y7mhkxq-1mw

# --- Telegram ---
# Bot token from @BotFather (looks like "123456789:AA...").
TELEGRAM_BOT_TOKEN=your-bot-token
# Any long random string YOU make up. Used to verify webhooks really come from Telegram.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# Your numeric Telegram user id (DM @userinfobot to find it, or read it from the server log
# the first time you message the bot). Only messages from this id are accepted.
ALLOWED_TELEGRAM_USER_ID=000000000

# --- This server ---
# The public HTTPS base URL of this server (no trailing slash). In local dev this is your
# tunnel URL (e.g. an ngrok/cloudflared https URL); in prod it's your Render app URL.
PUBLIC_BASE_URL=https://your-app.example.com
# Where downloaded photos are stored before are.na fetches them. Default is fine.
MEDIA_DIR=./media
# Local dev port. Cloud hosts usually set $PORT themselves.
PORT=8080
